From: simonez & Arci <322738847+simonezpx3@users.noreply.github.com>
Date: Sun, 22 Nov 2026 09:23:00 +0100
Subject: [PATCH] perf(llama-mmap): hint MADV_HUGEPAGE for file-backed GGUF mmap on Linux

Enables 2 MiB THP / large-folio backing for file-mapped GGUF weights on Linux
without MAP_HUGETLB (which fails with EINVAL on regular filesystem fds).
Silently ignores EINVAL when kernel THP is set to [never].
---
 src/llama-mmap.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/llama-mmap.cpp b/src/llama-mmap.cpp
--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -458,6 +458,12 @@ struct llama_mmap::impl {
         if (addr == MAP_FAILED) {
             throw std::runtime_error(format("mmap failed: %s", strerror(errno)));
         }
+#if defined(__linux__) && defined(MADV_HUGEPAGE)
+        if (madvise(addr, file->size(), MADV_HUGEPAGE) && errno != EINVAL) {
+            LLAMA_LOG_WARN("warning: madvise(.., MADV_HUGEPAGE) failed: %s\n",
+                    strerror(errno));
+        }
+#endif
 
         if (prefetch > 0) {
             if (posix_madvise(addr, std::min(file->size(), prefetch), POSIX_MADV_WILLNEED)) {
